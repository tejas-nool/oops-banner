# oops-banner:UC6-assignment:UC6-assignment
public class OOPSBannerApp {

    public static void main(String[] args) {

        String[] o = buildO();
        String[] p = buildP();
        String[] s = buildS();

        String[] bannerLines = new String[7];

        for (int i = 0; i < 7; i++) {
            bannerLines[i] = o[i] + " " + o[i] + " " + p[i] + " " + s[i];
        }

        for (String line : bannerLines) {
            System.out.println(line);
        }
    }

    // Build Letter O
    public static String[] buildO() {
        return new String[]{
            " ***** ",
            "*     *",
            "*     *",
            "*     *",
            "*     *",
            "*     *",
            " ***** "
        };
    }

    // Build Letter P
    public static String[] buildP() {
        return new String[]{
            "***** ",
            "*     *",
            "*     *",
            "***** ",
            "*      ",
            "*      ",
            "*      "
        };
    }

    // Build Letter S
    public static String[] buildS() {
        return new String[]{
            " *****",
            "*     ",
            "*     ",
            " *****",
            "      *",
            "      *",
            " *****"
        };
    }
}
