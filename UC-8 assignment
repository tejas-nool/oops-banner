# oops-banner:UC-8 assignment
import java.util.HashMap;
import java.util.Map;
public class OOPSBannerApp {

    // Centralized Pattern Store
    private static final Map<Character, String[]> PATTERN_MAP = new HashMap<>();

    static {
        PATTERN_MAP.put('O', new String[]{
                " ***** ",
                "*     *",
                "*     *",
                "*     *",
                "*     *",
                "*     *",
                " ***** "
        });

        PATTERN_MAP.put('P', new String[]{
                "***** ",
                "*     *",
                "*     *",
                "***** ",
                "*      ",
                "*      ",
                "*      "
        });

        PATTERN_MAP.put('S', new String[]{
                " *****",
                "*     ",
                "*     ",
                " *****",
                "      *",
                "      *",
                " *****"
        });
    }

    public static void main(String[] args) {

        String word = "OOPS";
        int bannerHeight = 7;

        for (int row = 0; row < bannerHeight; row++) {
            StringBuilder lineBuilder = new StringBuilder();

            for (char c : word.toCharArray()) {
                String[] pattern = PATTERN_MAP.getOrDefault(c, emptyPattern());
                lineBuilder.append(pattern[row]).append(" ");
            }

            System.out.println(lineBuilder);
        }
    }

    // Fallback for unsupported characters
    private static String[] emptyPattern() {
        return new String[]{
                "       ",
                "       ",
                "       ",
                "       ",
                "       ",
                "       ",
                "       "
        };
    }
}
